{
  "name": "PHP + MySQL Test",
  "dockerComposeFile": "docker-compose.yml",
  "service": "web",
  "workspaceFolder": "/var/www/html",
  "overrideCommand": false,
  "forwardPorts": [80, 8080],
"postStartCommand": "apache2ctl start || true",
  "portsAttributes": {
    "80": {
      "label": "Aplicație PHP",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "phpMyAdmin",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client"
      ]
    }
  }
}
